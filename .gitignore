# Copyrighted papers (not ours to redistribute) -- see READMEs for citations instead
TAS/Tele_Assistance_A_Self-Adaptive_Service-Based_System_Exemplar.pdf
BSN/Body Sensor Network: A Self-Adaptive System Exemplar in the Healthcare Domain.pdf
POLARIS/SEAMS_2025_AgenticFramework.pdf

# Build output produced by build.sh in each TAS variant (TAS.v1.6, TAS-ActivFORMS, ...)
TAS/*/*/out/

# Stale precompiled output shipped in the original distributions
TAS/*/*/bin/

# Stale Ant/NetBeans build+deploy tree shipped in the original distributions
# (duplicated source, duplicated libs, compiled classes, dist jars, old JNLP files)
TAS/*/TAS_gui/build/

# Eclipse workspace metadata (not per-project config -- large, personal, IDE-only)
TAS/*/.metadata/

# Runtime-generated output from running the GUI (TAS_gui/results/), in each TAS variant
TAS/*/TAS_gui/results/log.csv
TAS/*/TAS_gui/results/result.csv

# Top-level Python venv (requirements.txt)
.venv/

# Runtime activation traces: written by NLA/server during a POLARIS run,
# read back by the NLA pipeline. Shared artifact of the two, owned by neither,
# and moved between machines with rsync.
traces/

# Pidfiles and service logs written by the start scripts
run/

# Per-machine configuration (model, device, ports, trace dir). .env.example is
# committed and documents every key; the filled-in .env never is -- the whole
# point is that it differs per host.
.env

# macOS
**/.DS_Store

# Experiment intermediates. The scripts in experiments/ regenerate these from
# traces/ given a GPU; only the small results table and the paper figures are
# worth versioning. acts.npz alone is ~4 MB per run.
experiments/**/results/*.npz
experiments/**/results/explanations.json
experiments/**/results/meta.json
__pycache__/
*.pyc

# Paper sources and the term report build, kept out of the code repository.
LaTeX/
InitSummerWork.pdf

# Working context documents: notes and references written for/with the agent
# while developing, not part of the project's own record. Deliberately listed
# one by one rather than as *.md -- every README in the tree is markdown too.
LLM_Controller_Plan.md
POLARIS_WIRING_ISSUES.md
POLARIS_WIRING_AUDIT_2026-09.md
csf3-slurm-manual.md

# OMNeT++ raw vector output: tens of MB per run, regenerable only by re-running
# the 105-minute simulation, but everything the paper needs is already distilled
# into runs.json by collect.py. The .sca is small and worth keeping.
experiments/**/results/**/*.vec

# Third-party reference material: see external/README.md
external/*
!external/README.md
