# Copy to local.env (gitignored) and fill in. Nothing host- or account-specific
# belongs in a committed file -- this repository is the paper's public artifact.
#
#   cp csf/local.env.example csf/local.env && $EDITOR csf/local.env

export CSF_USER=your-csf-username
export CSF_HOST=csf3.itservices.manchester.ac.uk

# Slurm account accepted on gpuH/gpuH_short. Not necessarily the one in the CSF
# docs -- see "Check which account reaches the H200s" in README.md.
export CSF_ACCOUNT=your-gpu-account

# Optional overrides
export CSF_PARTITION=gpuH_short
export SELAS_MODEL=google/gemma-3-27b-it
