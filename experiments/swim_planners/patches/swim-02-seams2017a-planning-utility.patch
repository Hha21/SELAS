 using namespace std;
 
+// SELAS: mean of a server's service-time parameter, as SWIM's Model is meant to
+// hold it (Utils::getMeanAndVarianceFromParameter semantics: the first argument
+// of truncnormal/normal/exponential, or the constant). In SWIM_SA under
+// OMNeT++ 5.4.1 Model::getServiceTime() and getLowFidelityServiceTime() are 0,
+// so the planner reads the parameter itself.
+static double serviceTimeMean(const omnetpp::cPar& par) {
+    if (!par.isExpression()) {
+        return par.doubleValue();
+    }
+    std::string e = par.getExpression()->str();
+    std::string::size_type open = e.find('(');
+    if (open == std::string::npos) {
+        throw omnetpp::cRuntimeError("cannot read a mean from '%s'", e.c_str());
+    }
+    const char* start = e.c_str() + open + 1;
+    char* end = nullptr;
+    double v = strtod(start, &end);
+    if (end == start) {
+        throw omnetpp::cRuntimeError("cannot read a mean from '%s'", e.c_str());
+    }
+    while (*end == ' ') end++;
+    if (end[0] == 'm' && end[1] == 's') v /= 1000.0;     // otherwise seconds
+    return v;
+}
+
 Define_Module(ProactiveAdaptationManager);
 
