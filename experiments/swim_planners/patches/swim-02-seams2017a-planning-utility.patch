+/*******************************************************************************
+ * SELAS addition to clayness/swim's ProactiveAdaptationManager (PLA-SDP port).
+ *
+ * The planning utility of SWIM's reported metric, SEAMS 2017A (Moreno et al.,
+ * "Comparing model-based predictive approaches to self-adaptation: CobRA and
+ * PLA", SEAMS 2017; periodUtilitySEAMS2017A in SWIM's tools/plotResults.R),
+ * as a pladapt::UtilityFunction, replacing Stevens's DartUtilityFunction
+ * (0.4 cost + 0.1 dimmer + 0.5 response time) when the manager's
+ * planningUtility parameter asks for it. Everything else in the planner is
+ * unchanged: reachability relation, look-ahead, environment model, tactics.
+ *
+ * Per period, for a planner configuration (s, d, p) and predicted arrival rate
+ * lambda (requests/s, the environment value the manager already predicts):
+ *
+ *   dimmer      df = d / (levels - 1)
+ *   active      c  = s + 1             (the manager encodes servers as active-1)
+ *   provisioned c + 1 if a server is booting (p != levels-of-progress - 1), else c
+ *   revenue     ur = lambda * ((1 - df) * 1.0 + df * 1.5)
+ *   late        predicted response time > responseTimeThreshold
+ *   utility     not late, ur >= lambda * 1.5 - 1e-5 : ur + 10 * (maxServers - provisioned)
+ *               not late                            : ur
+ *               late                                : min(0, lambda - maxServers * maxServiceRate) * 1.5
+ *
+ * Response time comes from the M/M/c model the port already uses
+ * (MMcQueue::totalTime). Two ways of feeding it, chosen by the caller:
+ *
+ *   SWIM_UNITS     c active servers, arrival rate lambda, mean service time
+ *                  df * S + (1 - df) * S_low, S and S_low given by the caller:
+ *                  the means of the servers' serviceTime and
+ *                  lowFidelityServiceTime parameters (0.030 s, 0.001 s), or
+ *                  S = 1/maxServiceRate for the "seams2017a-maxrate" variant.
+ *                  (SWIM's Model::getServiceTime() would be the natural source,
+ *                  but it is 0 in SWIM_SA under OMNeT++ 5.4.1.)
+ *   STEVENS_INPUTS Stevens's call verbatim -- totalTime(s, 0.001 * 1.2^(9-d),
+ *                  60000/lambda, ...) -- read as milliseconds. Those inputs are
+ *                  not in SWIM's units (service alone takes 1 s at full dimmer),
+ *                  so this is a sensitivity variant, not the main one.
+ ******************************************************************************/
+#ifndef SEAMS2017APLANNINGUTILITY_H_
+#define SEAMS2017APLANNINGUTILITY_H_
+
+#include <managers/adaptation/proactive/include/UtilityFunction.h>
+
+class Seams2017aPlanningUtility : public pladapt::UtilityFunction {
+public:
+    enum RtModel { SWIM_UNITS, STEVENS_INPUTS };
+
+    Seams2017aPlanningUtility(RtModel rtModel, unsigned maxServers, double maxServiceRate,
+            double rtThreshold, unsigned dimmerLevels, unsigned progressStates,
+            double serviceTime, double lowFidelityServiceTime);
+
+    virtual double getAdditiveUtility(const pladapt::Configuration& config,
+            const pladapt::Environment& env, int time) const;
+
+    /** predicted mean response time in seconds (exposed for logging/tests) */
+    double predictedResponseTime(unsigned servers0, unsigned dimmerLevel, double arrivalRate) const;
+
+    virtual ~Seams2017aPlanningUtility();
+
+protected:
+    RtModel rtModel;
+    unsigned maxServers;
+    double maxServiceRate;
+    double rtThreshold;
+    unsigned dimmerLevels;
+    unsigned progressStates;
+    double serviceTime;
+    double lowFidelityServiceTime;
+};
+
+#endif /* SEAMS2017APLANNINGUTILITY_H_ */
--- a/src/managers/adaptation/Seams2017aPlanningUtility.cc	1970-01-01 01:00:00.000000000 +0100
+++ b/src/managers/adaptation/Seams2017aPlanningUtility.cc	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,67 @@
+/*******************************************************************************
+ * SELAS addition: SEAMS 2017A as PLA-SDP's planning utility. See the header.
+ ******************************************************************************/
+#include "Seams2017aPlanningUtility.h"
+#include <managers/adaptation/dartam/include/dartam/DartConfiguration.h>
+#include <managers/adaptation/dartam/include/dartam/DartSimpleEnvironment.h>
+#include <util/MMcQueue.h>
+#include <algorithm>
+#include <cfloat>
+#include <cmath>
+
+Seams2017aPlanningUtility::Seams2017aPlanningUtility(RtModel rtModel, unsigned maxServers,
+        double maxServiceRate, double rtThreshold, unsigned dimmerLevels, unsigned progressStates,
+        double serviceTime, double lowFidelityServiceTime)
+    : rtModel(rtModel), maxServers(maxServers), maxServiceRate(maxServiceRate),
+      rtThreshold(rtThreshold), dimmerLevels(dimmerLevels), progressStates(progressStates),
+      serviceTime(serviceTime), lowFidelityServiceTime(lowFidelityServiceTime) {
+}
+
+double Seams2017aPlanningUtility::predictedResponseTime(unsigned servers0, unsigned dimmerLevel,
+        double arrivalRate) const {
+    if (rtModel == STEVENS_INPUTS) {
+        // DartUtilityFunction's call, unchanged; its result is in milliseconds.
+        double mu = 0.001 * pow(1.2, 9.0 - dimmerLevel);
+        double ms = MMcQueue::totalTime(servers0, mu, 60000 / arrivalRate, 60000 / arrivalRate);
+        return ms / 1000.0;
+    }
+    double df = double(dimmerLevel) / (dimmerLevels - 1);
+    double meanService = df * serviceTime + (1.0 - df) * lowFidelityServiceTime;
+    double mu = 1.0 / meanService;
+    unsigned c = servers0 + 1;
+    if (!(arrivalRate > 0)) {
+        return 1.0 / mu;                    // no arrivals: no queueing
+    }
+    return MMcQueue::totalTime(c, mu, 1.0 / arrivalRate, 1.0 / arrivalRate);   // DBL_MAX if rho > 1
+}
+
+double Seams2017aPlanningUtility::getAdditiveUtility(const pladapt::Configuration& config,
+        const pladapt::Environment& env, int time) const {
+    const dart::am2::DartConfiguration& c = dynamic_cast<const dart::am2::DartConfiguration&>(config);
+    const dart::am2::DartSimpleEnvironment& e = dynamic_cast<const dart::am2::DartSimpleEnvironment&>(env);
+
+    double lambda = std::max(0.0, e.getProbOfObject());     // predicted arrival rate, requests/s
+    double df = double(c.getDimmer()) / (dimmerLevels - 1);
+    unsigned active = c.getServers() + 1;
+    bool booting = c.getTtcAddServer() != progressStates - 1;  // last progress state = not running
+    double provisioned = active + (booting ? 1 : 0);
+
+    double rt = predictedResponseTime(c.getServers(), c.getDimmer(), lambda);
+    bool late = !(rt <= rtThreshold) || rt < 0;
+
+    // periodUtilitySEAMS2017A (plotResults.R), as swim_utility.py computes it
+    const double precision = 1e-5;
+    double ur = lambda * ((1 - df) * 1.0 + df * 1.5);
+    double uc = 10 * (maxServers - provisioned);
+    double urOpt = lambda * 1.5;
+    if (!late && ur >= urOpt - precision) {
+        return ur + uc;
+    }
+    if (!late) {
+        return ur;
+    }
+    return std::min(0.0, lambda - maxServers * maxServiceRate) * 1.5;
+}
+
+Seams2017aPlanningUtility::~Seams2017aPlanningUtility() {
+}
